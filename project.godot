; Stress Test — 3D horror party game (Godot 4.4+)
config_version=5

[application]

config/name="Stress Test"
config/description="Party game kinh dị 10 cửa cho 3–4 người"
config/version="0.5.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
